# 서울 열린데이터광장(data.seoul.go.kr) 인증키 — 무료, 신청 즉시 발급
# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. (sample 키는 소량 테스트용)
# GitHub 에서는 .env 대신 저장소 Settings > Secrets > Actions 에 SEOUL_API_KEY 로 등록합니다.
SEOUL_API_KEY=sample
PORT=3000

# 공공데이터포털 인증키 — 한국관광공사 '국문 관광정보 서비스'(TourAPI) 활용신청 후 발급. 경기도·안전체험관 장소에 필요
# GitHub 에서는 Secrets 에 TOURAPI_KEY 로 등록합니다.
TOURAPI_KEY=
